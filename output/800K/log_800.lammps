timestep        0.001

fix             1 all nvt temp ${T} ${T} 0.1
fix             1 all nvt temp 800 ${T} 0.1
fix             1 all nvt temp 800 800 0.1

# Neck size: atoms in a 4 A slab at the mid-plane (follows the centre of mass)
variable        xlo equal xcm(all,x)-2.0
variable        xhi equal xcm(all,x)+2.0
region          neck block v_xlo v_xhi INF INF INF INF
variable        nneck equal count(all,neck)

# Overall size: radius of gyration falls as the pair becomes one particle
compute         rg all gyration

thermo          1000
thermo_style    custom step time temp pe ke etotal c_rg v_nneck

dump            1 all custom 1000 traj_${T}.lammpstrj id type x y z
dump            1 all custom 1000 traj_800.lammpstrj id type x y z

run             ${NSTEPS}
